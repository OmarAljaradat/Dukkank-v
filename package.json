{
  "name": "workspace",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build && node ./scripts/prepare-dist.mjs",
    "vercel-build": "pnpm --filter './artifacts/**' -r --if-present run build && node ./scripts/prepare-dist.mjs",
    "start": "pnpm -r --filter @workspace/api-server run start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@rollup/rollup-win32-x64-msvc": "^4.63.0",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}
