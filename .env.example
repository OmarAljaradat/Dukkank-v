# Environment Variables Example for Dukkank Store
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
ADMIN_EMAIL=admin@dukkank.com
ADMIN_PASSWORD=your_admin_password_here
RESEND_API_KEY=your_resend_api_key_here
PAYTABS_PROFILE_ID=your_paytabs_profile_id
PAYTABS_SERVER_KEY=your_paytabs_server_key
PAYTABS_CLIENT_KEY=your_paytabs_client_key
DATABASE_URL=postgresql://username:password@localhost:5432/dukkank_db
